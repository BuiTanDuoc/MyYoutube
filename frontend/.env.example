# Dev only: where Vite forwards /api and /media (the .NET API). Default: https://localhost:7100
VITE_API_PROXY=https://localhost:7100

# Production build only: absolute URL of the API when it is NOT served from the same origin
# (leave empty when a reverse proxy serves both). Remember to add the site origin to Cors:AllowedOrigins.
VITE_API_URL=
