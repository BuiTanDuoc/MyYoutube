{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MiniTube;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "MiniTube",
    "Audience": "MiniTube.Client",
    "Key": "CHANGE_ME_use_user_secrets_or_env_var_at_least_32_chars_long",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Storage": {
    "RootPath": "storage",
    "RequestPath": "/media"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
