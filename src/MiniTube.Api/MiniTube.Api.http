@host = https://localhost:7100

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "john@example.com", "userName": "john", "password": "Passw0rd!", "displayName": "John" }

### Login (email or username)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "identifier": "john", "password": "Passw0rd!" }

### Refresh
POST {{host}}/api/auth/refresh
Content-Type: application/json

{ "refreshToken": "PASTE_REFRESH_TOKEN" }

### Me
GET {{host}}/api/users/me
Authorization: Bearer PASTE_ACCESS_TOKEN

### Admin: list users
GET {{host}}/api/admin/users?page=1&pageSize=20&search=jo
Authorization: Bearer PASTE_ADMIN_ACCESS_TOKEN

### Confirm email (userId + token come from the link in the email / console log)
POST {{host}}/api/auth/confirm-email
Content-Type: application/json

{ "userId": "PASTE_USER_ID", "token": "PASTE_TOKEN" }

### Resend confirmation
POST {{host}}/api/auth/resend-confirmation
Content-Type: application/json
Accept-Language: en

{ "email": "john@example.com" }

### Forgot password
POST {{host}}/api/auth/forgot-password
Content-Type: application/json
Accept-Language: vi

{ "email": "john@example.com" }

### Reset password
POST {{host}}/api/auth/reset-password
Content-Type: application/json

{ "email": "john@example.com", "token": "PASTE_TOKEN", "newPassword": "NewPassw0rd!" }

### Upload avatar
PUT {{host}}/api/users/me/avatar
Authorization: Bearer PASTE_ACCESS_TOKEN
Content-Type: multipart/form-data; boundary=X

--X
Content-Disposition: form-data; name="file"; filename="me.png"
Content-Type: image/png

< ./me.png
--X--

### Remove avatar
DELETE {{host}}/api/users/me/avatar
Authorization: Bearer PASTE_ACCESS_TOKEN

### ---- Videos ----
### 1) Create metadata (needs a verified email; the seeded admin is verified)
POST {{host}}/api/videos
Authorization: Bearer PASTE_ACCESS_TOKEN
Content-Type: application/json

{ "title": "My first video", "description": "Hello", "visibility": "Public" }

### 2) Upload the file as the raw body
PUT {{host}}/api/videos/PASTE_VIDEO_ID/source?fileName=test.mp4
Authorization: Bearer PASTE_ACCESS_TOKEN
Content-Type: application/octet-stream

< ./test.mp4

### 3) Poll status (processingProgress is returned to the owner)
GET {{host}}/api/videos/PASTE_VIDEO_ID
Authorization: Bearer PASTE_ACCESS_TOKEN

### Public list
GET {{host}}/api/videos?page=1&pageSize=20

### My videos (all statuses)
GET {{host}}/api/videos/mine?status=Failed
Authorization: Bearer PASTE_ACCESS_TOKEN

### Reprocess a failed video
POST {{host}}/api/videos/PASTE_VIDEO_ID/reprocess
Authorization: Bearer PASTE_ACCESS_TOKEN

### Delete
DELETE {{host}}/api/videos/PASTE_VIDEO_ID
Authorization: Bearer PASTE_ACCESS_TOKEN

### HLS master playlist
GET {{host}}/api/stream/PASTE_VIDEO_ID/master.m3u8

### ---- Playback ----
### Count a view (anonymous allowed; call once after ~30 s of real watching)
POST {{host}}/api/videos/PASTE_VIDEO_ID/views

### Progress heartbeat (signed-in)
PUT {{host}}/api/videos/PASTE_VIDEO_ID/progress
Authorization: Bearer PASTE_ACCESS_TOKEN
Content-Type: application/json

{ "positionSeconds": 73.5 }

### Like / Dislike / remove (type null)
PUT {{host}}/api/videos/PASTE_VIDEO_ID/reaction
Authorization: Bearer PASTE_ACCESS_TOKEN
Content-Type: application/json

{ "type": "Like" }

### Liked videos
GET {{host}}/api/videos/liked?page=1&pageSize=20
Authorization: Bearer PASTE_ACCESS_TOKEN

### Watch history
GET {{host}}/api/users/me/history?page=1&pageSize=20
Authorization: Bearer PASTE_ACCESS_TOKEN

### Remove one entry / clear all
DELETE {{host}}/api/users/me/history/PASTE_VIDEO_ID
Authorization: Bearer PASTE_ACCESS_TOKEN

###
DELETE {{host}}/api/users/me/history
Authorization: Bearer PASTE_ACCESS_TOKEN

### Pause / resume watch history
PUT {{host}}/api/users/me/history/settings
Authorization: Bearer PASTE_ACCESS_TOKEN
Content-Type: application/json

{ "paused": true }

### ---- Playlists ----
### Create
POST {{host}}/api/playlists
Authorization: Bearer PASTE_ACCESS_TOKEN
Content-Type: application/json

{ "title": "Favourites", "description": "My picks", "visibility": "Public" }

### My playlists (Watch later first). videoId marks which ones already contain that video.
GET {{host}}/api/playlists/mine?videoId=PASTE_VIDEO_ID
Authorization: Bearer PASTE_ACCESS_TOKEN

### Built-in Watch later
GET {{host}}/api/playlists/watch-later
Authorization: Bearer PASTE_ACCESS_TOKEN

### Public playlists (optionally ?ownerId=)
GET {{host}}/api/playlists?page=1&pageSize=20

### Detail + items
GET {{host}}/api/playlists/PASTE_PLAYLIST_ID

###
GET {{host}}/api/playlists/PASTE_PLAYLIST_ID/items?page=1&pageSize=50

### Add a video
POST {{host}}/api/playlists/PASTE_PLAYLIST_ID/items
Authorization: Bearer PASTE_ACCESS_TOKEN
Content-Type: application/json

{ "videoId": "PASTE_VIDEO_ID" }

### Move an item right after another one (afterItemId null = to the top)
PUT {{host}}/api/playlists/PASTE_PLAYLIST_ID/items/PASTE_ITEM_ID/move
Authorization: Bearer PASTE_ACCESS_TOKEN
Content-Type: application/json

{ "afterItemId": null }

### Remove by item id / by video id
DELETE {{host}}/api/playlists/PASTE_PLAYLIST_ID/items/PASTE_ITEM_ID
Authorization: Bearer PASTE_ACCESS_TOKEN

###
DELETE {{host}}/api/playlists/PASTE_PLAYLIST_ID/videos/PASTE_VIDEO_ID
Authorization: Bearer PASTE_ACCESS_TOKEN

### Update / delete the playlist
PUT {{host}}/api/playlists/PASTE_PLAYLIST_ID
Authorization: Bearer PASTE_ACCESS_TOKEN
Content-Type: application/json

{ "title": "Renamed", "description": null, "visibility": "Unlisted" }

###
DELETE {{host}}/api/playlists/PASTE_PLAYLIST_ID
Authorization: Bearer PASTE_ACCESS_TOKEN
